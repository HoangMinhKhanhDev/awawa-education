APP_NAME=awawa
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Nếu không tạo được symlink storage (Hostinger tắt symlink()): trỏ thẳng tới public/storage
# PUBLIC_DISK_ROOT=/home/USER/domains/awawa.herspalab.com/public/storage
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@awawa.herbspalab.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Super Admin đầu tiên (seeder) ---
# Để trống ADMIN_PASSWORD thì seeder bỏ qua, tránh mật khẩu mặc định yếu lọt lên prod.
ADMIN_NAME="awawa Admin"
ADMIN_EMAIL=admin@awawa.local
ADMIN_PASSWORD=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Danh sách domain email được phép (phân tách bằng dấu phẩy). Để trống = cho phép tất cả.
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# --- AI Providers ---
AI_DEFAULT_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/free
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=
AGNES_DEFAULT_MODEL=
# Chờ thử lại khi nhà cung cấp miễn phí trả 429: giây chờ mỗi lần, số lần thử và tổng thời gian chờ tối đa
AI_RATE_LIMIT_RETRY_DELAY=10
AI_RATE_LIMIT_MAX_ATTEMPTS=2
AI_RATE_LIMIT_MAX_TOTAL_WAIT=20

# --- Notebook (AI Studio) ---
AI_STREAM=true
NOTEBOOK_MAX_SOURCES=20
NOTEBOOK_MAX_FILE_MB=10
NOTEBOOK_MAX_SOURCE_CHARS=200000
NOTEBOOK_MAX_PROMPT_CHARS=400000
NOTEBOOK_HISTORY_MESSAGES=6
# Ngữ cảnh gửi lên mỗi lượt chat: số chunk tối đa (riêng phần soạn nội dung), kích thước chunk, phần chồng giữa hai chunk
NOTEBOOK_MAX_CONTEXT_CHUNKS=12
NOTEBOOK_MAX_ARTIFACT_CONTEXT_CHUNKS=8
NOTEBOOK_CHUNK_SIZE=1000
NOTEBOOK_CHUNK_OVERLAP=150
# Số notebook tối đa mỗi tài khoản
NOTEBOOK_MAX_NOTEBOOKS=20
# Tiến trình nền soạn nội dung: trần token mỗi lần soạn, giây chờ tối đa, số phút coi là treo và bộ nhớ
NOTEBOOK_MAX_ARTIFACT_TOKENS=6000
NOTEBOOK_ARTIFACT_TIMEOUT=300
NOTEBOOK_STALE_MINUTES=30
NOTEBOOK_GENERATION_MEMORY=1024M
# Tìm nguồn web: tavily hoặc exa — có thể đặt trong trang Tích hợp của admin
WEB_SEARCH_PROVIDER=tavily
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=8
EXA_BASE_URL=https://api.exa.ai
EXA_API_KEY=
EXA_MAX_RESULTS=8

# --- Web Push (VAPID) ---
VAPID_SUBJECT="mailto:no-reply@awawa.herbspalab.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
