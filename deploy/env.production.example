APP_NAME=awawa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://awawa.herspalab.com
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# MySQL của Hostinger (lấy trong hPanel > Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# File cache nhẹ hơn cho shared hosting
CACHE_STORE=file

# SMTP Hostinger (hPanel > Email)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@awawa.herspalab.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Super Admin đầu tiên ---
ADMIN_NAME="awawa Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Google OAuth (Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://awawa.herspalab.com/auth/google/callback"
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# --- AI Providers ---
AI_DEFAULT_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/free
AGNES_BASE_URL=
AGNES_API_KEY=
AGNES_DEFAULT_MODEL=agnes-chat

# --- Web Push (sinh bằng: php artisan awawa:vapid-keys) ---
VAPID_SUBJECT="mailto:no-reply@awawa.herspalab.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

VITE_APP_NAME="${APP_NAME}"
